RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.superfil\.com\.ar$ [NC]
RewriteRule ^ https://superfil.com.ar%{REQUEST_URI} [R=301,L]
RewriteBase /landings/cielorrasos/index.html
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /landings/cielorrasos/index.html [L]